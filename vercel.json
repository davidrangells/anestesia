{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.anestesiaquestoes.com.br" }],
      "destination": "https://anestesiaquestoes.com.br/$1",
      "permanent": true
    },
    { "source": "/checkout-config", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
